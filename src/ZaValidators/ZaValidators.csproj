<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>ZaValidators</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mayhur Mooni</Authors>
    <Description>Validation and parsing for South African identifiers: ID numbers, income tax and VAT numbers, CIPC company registration numbers and phone numbers.</Description>
    <PackageTags>south-africa;validation;id-number;sars;vat;cipc</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MayhurJoker007/za-validators</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
